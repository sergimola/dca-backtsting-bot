          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG((summary->>'winRate')::numeric) * 100, 2) AS \"Avg Win Rate\" FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND summary->>'winRate' IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Avg Total Fees",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG((summary->>'totalFees')::numeric), 4) AS \"Avg Total Fees\" FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "All Completed Runs",
      "description": "Full list of completed backtest runs. Click the arrow on a Run ID cell to open the Narrow Events Timeline for that run.",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 14 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "enablePagination": false,
          "countRows": false,
          "fields": ["ROI %", "Max Drawdown %", "Total Fees"]
        },
        "showHeader": true,
        "sortBy": [{ "displayName": "Created", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ROI %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "applyToRow": false }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "rgba(245,54,54,0.7)", "value": null },
                    { "color": "rgba(50,172,45,0.7)", "value": 0 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Max Drawdown %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "red", "value": 25 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Exec Time (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Run ID" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Narrow Events Timeline",
                    "url": "/d/dca-narrow-timeline?var-run_id=${__data.fields[\"Run ID\"]}",
                    "targetBlank": false
                  },
                  {
                    "title": "Open in Wide Events Deep Dive",
                    "url": "/d/dca-wide-events?var-run_id=${__data.fields[\"Run ID\"]}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Orders" },
            "properties": [{ "id": "custom.width", "value": 70 }]
          },
          {
            "matcher": { "id": "byName", "options": "Win Rate %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 50 },
                    { "color": "green", "value": 70 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id::text AS \"Run ID\", created_at AS \"Created\", config->>'trading_pair' AS \"Pair\", config->>'start_date' AS \"Backtest Start\", config->>'end_date' AS \"Backtest End\", (config->>'account_balance')::numeric AS \"Account Balance\", (config->>'number_of_orders')::int AS \"Orders\", (config->>'take_profit_distance_percent')::numeric AS \"TP %\", config->>'stop_loss_enabled' AS \"SL Enabled\", config->>'stop_loss_percent' AS \"SL %\", ROUND((summary->>'roi')::numeric, 2) AS \"ROI %\", ROUND((summary->>'maxDrawdown')::numeric, 2) AS \"Max Drawdown %\", ROUND(NULLIF((summary->>'winRate'), '')::numeric * 100, 2) AS \"Win Rate %\", ROUND((summary->>'totalFees')::numeric, 2) AS \"Total Fees\", execution_time_ms AS \"Exec Time (ms)\" FROM backtests WHERE status = 'completed' AND config->>'trading_pair' IN (${trading_pair:singlequote}) ORDER BY created_at DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Avg ROI by Trading Pair",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -30,
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.1,
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "xField": "Pair"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT config->>'trading_pair' AS \"Pair\", ROUND(AVG((summary->>'roi')::numeric), 2) AS \"Avg ROI\", ROUND(MAX((summary->>'roi')::numeric), 2) AS \"Best ROI\", ROUND(MIN((summary->>'roi')::numeric), 2) AS \"Worst ROI\" FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote}) GROUP BY config->>'trading_pair' ORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Runs Completed Over Time",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1d') AS time, COUNT(*) AS \"Runs\" FROM backtests WHERE status = 'completed' AND $__timeFilter(created_at) AND config->>'trading_pair' IN (${trading_pair:singlequote}) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "ROI Distribution",
      "description": "Distribution of ROI across all completed runs for selected trading pairs.",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "bucketSize": "auto",
        "bucketOffset": 0,
        "combine": false,
        "fillOpacity": 80,
        "gradientMode": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((summary->>'roi')::numeric, 2) AS \"ROI\" FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote}) ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Avg Max Drawdown by Trading Pair",
      "description": "Higher drawdown = more capital at risk during the run.",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -30,
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.1,
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "xField": "Pair"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT config->>'trading_pair' AS \"Pair\", ROUND(AVG((summary->>'maxDrawdown')::numeric), 2) AS \"Avg Drawdown\", ROUND(MAX((summary->>'maxDrawdown')::numeric), 2) AS \"Worst Drawdown\" FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote}) GROUP BY config->>'trading_pair' ORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Safety Order Usage by Run",
      "description": "How deep a run went into safety orders. Click the arrow on a Run ID to drill into the timeline.",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "Created", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Run ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Narrow Events Timeline",
                    "url": "/d/dca-narrow-timeline?var-run_id=${__data.fields[\"Run ID\"]}",
                    "targetBlank": false
                  },
                  {
                    "title": "Open in Wide Events Deep Dive",
                    "url": "/d/dca-wide-events?var-run_id=${__data.fields[\"Run ID\"]}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.id::text AS \"Run ID\", b.created_at AS \"Created\", b.config->>'trading_pair' AS \"Pair\", ROUND((b.summary->>'roi')::numeric, 2) AS \"ROI %\", jsonb_array_length(b.safety_orders) AS \"SO Depths Used\", (SELECT MAX((so->>'count')::int) FROM jsonb_array_elements(b.safety_orders) AS so) AS \"Max SO Hits\", (SELECT SUM((so->>'count')::int) FROM jsonb_array_elements(b.safety_orders) AS so) AS \"Total SO Fills\" FROM backtests b WHERE status = 'completed' AND safety_orders IS NOT NULL AND config->>'trading_pair' IN (${trading_pair:singlequote}) ORDER BY b.created_at DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "ROI Over Time (per run)",
      "description": "Each point is the final ROI of a completed run, plotted by its creation time.",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "dca_postgres" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 0,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dca_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, ROUND((summary->>'roi')::numeric, 2) AS \"ROI\", config->>'trading_pair' AS metric FROM backtests WHERE status = 'completed' AND summary IS NOT NULL AND $__timeFilter(created_at) AND config->>'trading_pair' IN (${trading_pair:singlequote}) ORDER BY created_at",
          "refId": "A"
        }
      ]
    }
  ],
